{#
  Cart page. Variable table confirmed against Twilight's documented Cart
  object (docs.salla.dev/422575m0).

| Variable                                 | Type    | Description                        |
|--------------------------------------------|---------|--------------------------------------|
| cart.items[]                               | array   |                                       |
| cart.items[].id                            | int     |                                       |
| cart.items[].url                           | string  |                                       |
| cart.items[].product_name                  | string  |                                       |
| cart.items[].product_image                 | string  |                                       |
| cart.items[].quantity                      | int     |                                       |
| cart.items[].price                         | Money   |                                       |
| cart.items[].total                         | Money   |                                       |
| cart.items[].is_available                  | bool    |                                       |
| cart.items[].is_hidden_quantity            | bool    |                                       |
| cart.items[].max_quantity                  | int     |                                       |
| cart.free_shipping_bar.has_free_shipping   | bool    |                                       |
| cart.free_shipping_bar.percent             | float   | 0–100                                |
| cart.free_shipping_bar.remaining           | float   |                                       |
| cart.real_discount                         | float   |                                       |
#}
{% extends "layouts.master" %}

{% block content %}
  <div class="container ph-breadcrumb-wrap">
    <salla-breadcrumb></salla-breadcrumb>
  </div>
  <h1 class="sr-only">{{ trans('blocks.header.cart') }}</h1>

  <salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer>

  <div class="container ph-cart">
    <div class="ph-cart__items">
      {% hook 'cart:items.start' %}

      {% if cart.items|length %}
        {% for item in cart.items %}
          <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}" class="ph-cart-item">
            <input type="hidden" name="id" value="{{ item.id }}">

            <a href="{{ item.url }}" class="ph-cart-item__image">
              <img src="{{ item.product_image }}" alt="{{ item.product_name }}" loading="lazy">
            </a>

            <div class="ph-cart-item__info">
              <a href="{{ item.url }}" class="ph-cart-item__name">{{ item.product_name }}</a>

              <div class="ph-cart-item__price">
                {% if item.has_discount %}
                  <span class="was">{{ item.product_price|money }}</span>
                {% endif %}
                <span class="now">{{ item.price|money }}</span>
              </div>

              {% include 'pages.partials.product.options' with { product: item } %}
            </div>

            <div class="ph-cart-item__qty">
              {% if item.is_hidden_quantity %}
                <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity">
                <span>{{ item.quantity }}</span>
              {% else %}
                <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                                       value="{{ item.quantity }}" name="quantity" aria-label="Quantity"></salla-quantity-input>
              {% endif %}
            </div>

            <div class="ph-cart-item__total">
              <span>{{ trans('pages.cart.total') }}</span>
              <b>{{ item.is_available ? item.total|money : trans('pages.cart.out_of_stock') }}</b>
            </div>

            <salla-button data-testid="store-cart-delete-item" type="button" shape="icon" size="small" color="danger"
                          class="ph-cart-item__remove" aria-label="حذف من السلة"
                          onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
              <i class="sicon-cancel"></i>
            </salla-button>
          </form>
        {% endfor %}
      {% else %}
        <div data-testid="store-cart-empty" class="ph-empty-state">
          <i class="sicon-shopping-bag"></i>
          <p>{{ trans('pages.cart.empty_cart') }}</p>
          <a data-testid="store-cart-back-home" href="{{ link('/') }}" class="btn btn-outline">{{ trans('common.elements.back_home') }}</a>
        </div>
      {% endif %}

      <salla-offer data-testid="store-cart-offer"></salla-offer>
      {% hook 'cart:items.end' %}
    </div>

    {% hook 'cart:summary.start' %}

    {% if cart.items|length %}
      <aside class="ph-cart__summary">

        {% if cart.free_shipping_bar %}
          <div class="ph-free-shipping">
            <i class="sicon-shipping-fast"></i>
            <div>
              <h4>{{ trans('pages.cart.free_shipping') }}</h4>
              <p>{{ (cart.free_shipping_bar.has_free_shipping
                    ? trans('pages.cart.has_free_shipping')
                    : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))|raw }}</p>
              {% if not cart.free_shipping_bar.has_free_shipping %}
                <div class="ph-free-shipping__bar">
                  <div class="ph-free-shipping__fill" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if store.settings.cart.apply_coupon_enabled %}
          <div class="ph-cart-coupon">
            {% hook 'cart:coupon.start' %}
            <salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons>
            {% hook 'cart:coupon.end' %}
          </div>
        {% endif %}

        {# <salla-cart-summary-card> renders subtotal / discount / shipping /
           tax / total and the checkout CTA itself, from the same `cart`
           object — PRIME HOUSE never re-implements this math. #}
        {% hook 'cart:summary-card.start' %}
        <salla-cart-summary-card data-testid="store-cart-summary" class="ph-cart-summary-card"></salla-cart-summary-card>
        {% hook 'cart:summary-card.end' %}
        {% hook 'cart:summary.end' %}
      </aside>
    {% endif %}
  </div>
{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
